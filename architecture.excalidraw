    },
    {
      "id": "tauri_body",
      "type": "text",
      "x": 32, "y": 210, "width": 400, "height": 485,
      "angle": 0,
      "strokeColor": "#1e40af", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null,
      "roundness": null, "seed": 3015, "version": 1, "versionNonce": 3015,
      "isDeleted": false, "boundElements": null,
      "updated": 1716422400000, "link": null, "locked": false,
      "text": "WINDOWS\n  Orb  (floating, bottom-center of screen)\n    Ctrl+Shift+Space to activate + record\n    Sends webm/opus to POST /capture/stream\n    Gets SSE back: transcript, tools, TTS audio\n    Auto-positioned on primary monitor at setup\n\n  MainApp  (hides to tray on close)\n    Agent / Tasks / Memory / Reminders / Profile\n    Proactive SSE listener: /agent/proactive/stream\n    Client-side reminder audio scheduler\n\nTRAY MENU\n  Show Recall / Check for updates / Quit\n  Left click -> toggle MainApp visibility\n\nUPDATE FLOW  (startup + tray menu)\n  1. tauri_plugin_updater.check()\n     GET /updates/{os}/{arch}/{current_version}\n  2. emit(\"update-available\", version)\n  3. download_and_install() from GitHub CDN\n     emit(\"update-progress\", {downloaded, total})\n  4. emit(\"update-download-done\") -> restart prompt\n\nSIDECAR\n  Spawns recall-backend Python process\n  Reads PORT: prefix from stdout\n  Kills child process on exit",
      "fontSize": 12, "fontFamily": 2,
      "textAlign": "left", "verticalAlign": "top",
      "baseline": 11, "containerId": null,
      "originalText": "WINDOWS\n  Orb  (floating, bottom-center of screen)\n    Ctrl+Shift+Space to activate + record\n    Sends webm/opus to POST /capture/stream\n    Gets SSE back: transcript, tools, TTS audio\n    Auto-positioned on primary monitor at setup\n\n  MainApp  (hides to tray on close)\n    Agent / Tasks / Memory / Reminders / Profile\n    Proactive SSE listener: /agent/proactive/stream\n    Client-side reminder audio scheduler\n\nTRAY MENU\n  Show Recall / Check for updates / Quit\n  Left click -> toggle MainApp visibility\n\nUPDATE FLOW  (startup + tray menu)\n  1. tauri_plugin_updater.check()\n     GET /updates/{os}/{arch}/{current_version}\n  2. emit(\"update-available\", version)\n  3. download_and_install() from GitHub CDN\n     emit(\"update-progress\", {downloaded, total})\n  4. emit(\"update-download-done\") -> restart prompt\n\nSIDECAR\n  Spawns recall-backend Python process\n  Reads PORT: prefix from stdout\n  Kills child process on exit",
      "lineHeight": 1.4
    },
    {
      "id": "fastapi_box",
      "type": "rectangle",
      "x": 500, "y": 165, "width": 660, "height": 510,
      "angle": 0,
      "strokeColor": "#16a34a", "backgroundColor": "#dcfce7",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid",
