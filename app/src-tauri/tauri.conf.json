{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Recall",
    "version":  "0.3.1",
    "identifier":  "com.shivo.recall",
    "build":  {
                  "beforeDevCommand":  "pnpm dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "pnpm build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "Recall",
                                    "width":  920,
                                    "height":  640,
                                    "decorations":  false,
                                    "transparent":  true,
                                    "resizable":  true,
                                    "skipTaskbar":  false,
                                    "visible":  true
                                },
                                {
                                    "label":  "orb",
                                    "title":  "",
                                    "width":  140,
                                    "height":  140,
                                    "decorations":  false,
                                    "transparent":  true,
                                    "shadow":  false,
                                    "alwaysOnTop":  true,
                                    "skipTaskbar":  true,
                                    "resizable":  false,
                                    "visible":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "plugins":  {
                    "deep-link":  {
                                      "desktop":  {
                                                      "schemes":  ["recall"]
                                                  }
                                  }
                },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "currentUser"
                                            }
                               }
               }
}