    {
      "id": "supabase_body",
      "type": "text",
      "x": 510, "y": 784, "width": 410, "height": 215,
      "angle": 0,
      "strokeColor": "#5b21b6", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null,
      "roundness": null, "seed": 3024, "version": 1, "versionNonce": 3024,
      "isDeleted": false, "boundElements": null,
      "updated": 1716422400000, "link": null, "locked": false,
      "text": "Auth: Google OAuth SSO (JWT issued to desktop app)\n\nTables:\n  recall_items          items + HNSW vector embeddings\n  sessions              conversation history per user\n  email_style_profiles  Gmail writing-style data\n  proactive_jobs        cron output + delivery status\n  agent_chats           chat sessions + proactive inbox\n  users                 google_access_token, timezone,\n                        last_checkin_at (14-day inactivity guard)\n  user_behavior_patterns  pattern-learn output",
      "fontSize": 12, "fontFamily": 2,
      "textAlign": "left", "verticalAlign": "top",
      "baseline": 11, "containerId": null,
      "originalText": "Auth: Google OAuth SSO (JWT issued to desktop app)\n\nTables:\n  recall_items          items + HNSW vector embeddings\n  sessions              conversation history per user\n  email_style_profiles  Gmail writing-style data\n  proactive_jobs        cron output + delivery status\n  agent_chats           chat sessions + proactive inbox\n  users                 google_access_token, timezone,\n                        last_checkin_at (14-day inactivity guard)\n  user_behavior_patterns  pattern-learn output",
      "lineHeight": 1.4
    },
