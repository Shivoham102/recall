    },
    {
      "id": "fastapi_title",
      "type": "text",
      "x": 510, "y": 177, "width": 640, "height": 24,
      "angle": 0,
      "strokeColor": "#15803d", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null,
      "roundness": null, "seed": 3017, "version": 1, "versionNonce": 3017,
      "isDeleted": false, "boundElements": null,
      "updated": 1716422400000, "link": null, "locked": false,
      "text": "FastAPI Backend  (localhost:8000 dev / Vercel prod)",
      "fontSize": 17, "fontFamily": 2,
      "textAlign": "center", "verticalAlign": "top",
      "baseline": 15, "containerId": null, "originalText": "FastAPI Backend  (localhost:8000 dev / Vercel prod)", "lineHeight": 1.4
    },
    {
      "id": "fastapi_body",
      "type": "text",
      "x": 512, "y": 210, "width": 640, "height": 460,
      "angle": 0,
      "strokeColor": "#166534", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null,
      "roundness": null, "seed": 3018, "version": 1, "versionNonce": 3018,
      "isDeleted": false, "boundElements": null,
      "updated": 1716422400000, "link": null, "locked": false,
      "text": "ROUTES\n  POST /capture/stream         audio or text -> SSE (transcript, tools, TTS audio)\n  GET/PATCH /items/:id         memory CRUD\n  GET /reminders/*             reminders\n  GET /agent/proactive/stream  SSE delivery, polls Supabase every 30s\n  POST /agent/proactive/ack    mark job delivered\n  POST /agent/proactive/trigger  manual trigger\n  GET /updates/{os}/{arch}/{ver}  update manifest (GitHub API + .sig)\n  GET/POST /memory/*           Supermemory proxy\n  GET /jobs/*                  cron endpoints (protected by CRON_SECRET)\n\nAGENT LOOP  (Claude claude-sonnet-4-6 + tool use + prompt caching)\n  classify_intent  recall_search  recall_update_item  surface_tasks  file_create\n  gmail_get_updates  gmail_draft  gmail_find_contact\n  calendar_list  calendar_create\n\nPROACTIVE PIPELINE\n  Cron writes to proactive_jobs (status=done, delivered=false)\n  App SSE polls every 30s -> sends undelivered rows as events\n  App acks each job -> delivered=true in Supabase\n  Stale time-bounded jobs (morning_brief, follow_up_scan) auto-expired\n\nSTT: Cartesia ink-whisper   TTS: Cartesia sonic-2\nEmbeddings: OpenAI text-embedding-3-small",
      "fontSize": 12, "fontFamily": 2,
      "textAlign": "left", "verticalAlign": "top",
      "baseline": 11, "containerId": null,
      "originalText": "ROUTES\n  POST /capture/stream         audio or text -> SSE (transcript, tools, TTS audio)\n  GET/PATCH /items/:id         memory CRUD\n  GET /reminders/*             reminders\n  GET /agent/proactive/stream  SSE delivery, polls Supabase every 30s\n  POST /agent/proactive/ack    mark job delivered\n  POST /agent/proactive/trigger  manual trigger\n  GET /updates/{os}/{arch}/{ver}  update manifest (GitHub API + .sig)\n  GET/POST /memory/*           Supermemory proxy\n  GET /jobs/*                  cron endpoints (protected by CRON_SECRET)\n\nAGENT LOOP  (Claude claude-sonnet-4-6 + tool use + prompt caching)\n  classify_intent  recall_search  recall_update_item  surface_tasks  file_create\n  gmail_get_updates  gmail_draft  gmail_find_contact\n  calendar_list  calendar_create\n\nPROACTIVE PIPELINE\n  Cron writes to proactive_jobs (status=done, delivered=false)\n  App SSE polls every 30s -> sends undelivered rows as events\n  App acks each job -> delivered=true in Supabase\n  Stale time-bounded jobs (morning_brief, follow_up_scan) auto-expired\n\nSTT: Cartesia ink-whisper   TTS: Cartesia sonic-2\nEmbeddings: OpenAI text-embedding-3-small",
      "lineHeight": 1.4
    },
