      "isDeleted": false, "boundElements": null,
      "updated": 1716422400000, "link": null, "locked": false,
      "text": "Shivoham102/recall\n\nAssets per release:\n  Recall_*_x64-setup.exe\n    (Windows)\n  Recall_*.app.tar.gz\n    (macOS)\n  Recall_*.AppImage\n    (Linux)\n  *.sig  (Ed25519 per asset)\n\nGitHub API:\n  GET /repos/.../releases/latest\nCDN: direct installer download\nCache: s-maxage=300",
      "fontSize": 11, "fontFamily": 2,
      "textAlign": "left", "verticalAlign": "top",
      "baseline": 10, "containerId": null,
      "originalText": "Shivoham102/recall\n\nAssets per release:\n  Recall_*_x64-setup.exe\n    (Windows)\n  Recall_*.app.tar.gz\n    (macOS)\n  Recall_*.AppImage\n    (Linux)\n  *.sig  (Ed25519 per asset)\n\nGitHub API:\n  GET /repos/.../releases/latest\nCDN: direct installer download\nCache: s-maxage=300",
      "lineHeight": 1.4
    },
